# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Stripe Integration Credentials
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_SECRET2=""

# Sovereign & Security Config
SOVEREIGN_DEV_SECRET_SEED=""
FAPI_CALLBACK_URI=""
VITE_RECAPTCHA_SITE_KEY=""

# Wise (TransferWise) Integration Credentials
WISE_API_TOKEN=""
WISE_PROFILE_ID=""
WISE_PROFILE_NAME=""
WISE_MTLS_CERT_PATH=""
WISE_MTLS_KEY_PATH=""

# Google Pay & Android Package Whitelisting Credentials
ANDROID_PACKAGE_NAME=""
ANDROID_SHA256_FINGERPRINT=""
GOOGLE_PAY_ENV="PRODUCTION"
VITE_GOOGLE_PAY_ENV="PRODUCTION"
GOOGLE_PAY_MERCHANT_ID=""
GOOGLE_PAY_MERCHANT_NAME=""
GOOGLE_WALLET_ISSUER_ID=""
# Google Wallet pass signing — configure values only in Render; never commit service-account JSON or private keys.
# Preferred: complete one-line service-account JSON from your secret manager.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=""
# Alternative: set both fields if your platform cannot store the JSON object.
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WALLET_PRIVATE_KEY=""

# Durable application ledger. Render should point this at the persistent /data disk.
SOVEREIGN_DB_FILE_PATH="/data/database.json"
SOVEREIGN_LEDGER_PATH="/data/ledger_db.json"

# Android builds are release artifacts, not repository files. Point clients to a signed release URL.
ANDROID_APP_DOWNLOAD_URL=""

# Plaid Integration Credentials
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# Coinbase55 Production Ledger Credentials
LEDGER_API_KEY=""
COINBASE55_BASE_URL="https://coinbase55.com"

# Render Production Service Credentials
RENDER_SERVICE_ID="srv-d99sus57vvec7386p2p0"
RENDER_DEPLOY_HOOK_URL="https://api.render.com/deploy/srv-d99sus57vvec7386p2p0"
RENDER_DEPLOY_HOOK_KEY=""

# Bitcoin Native UTXO Send (disabled unless explicitly enabled)
BTC_NETWORK="mainnet"
BTC_RPC_URL=""
BTC_RPC_USER=""
BTC_RPC_PASSWORD=""
BTC_SIGNING_WIF=""
BTC_SOURCE_ADDRESS=""
BTC_FEE_RATE_SAT_VB="5"
BTC_ENABLE_BROADCAST="false"

# Production Dual-Channel Email Alerts
MAILERSEND_API_KEY=""
ALERT_FROM_EMAIL="alerts@sovereigns.ca"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Local Bitcoin ATM provider integration (disabled until a real operator is configured)
ATM_NETWORK=""
ATM_PROVIDER_API_URL=""
ATM_PROVIDER_API_KEY=""
ATM_PROVIDER_MERCHANT_ID=""
ATM_PROVIDER_WEBHOOK_SECRET=""
ATM_LOCATION_API_URL=""
ATM_SMS_DESTINATION=""
ATM_ENABLE_LIVE_OPERATIONS="false"
